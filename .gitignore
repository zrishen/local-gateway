# Runtime and local-only data
/logs/
/work/

# Generated kernel configuration
/config.json
/config.proxy.json
/config.next.json
/config.stage.json
/config.*.json
/config*.json.stage
/config*.json.previous

# Machine-local overrides and secrets
/settings.local.json
/gateway/*.local.json
/tools/network/

# Runtime state and secrets; third-party model configuration lives in gateway/
/state/*

# Bundled binary is installed from bin/source.json
/bin/*
!/bin/source.json

# Routing rules are deployable assets
/rules/*
!/rules/source.json
!/rules/*.srs

__pycache__/
*.pyc
.env
.venv/
.pytest_cache/
